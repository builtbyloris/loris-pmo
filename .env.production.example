# Copy to .env.production only on the deployment host. Never commit that file.
APP_ENV=production
SECRET_KEY=generate-a-random-value-of-at-least-48-characters-at-deploy-time
DATABASE_URL=postgresql+asyncpg://app_user:database-password@database-host:5432/loris_pmo
DATABASE_SSL_MODE=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

FRONTEND_URL=https://pmo.example.com
CORS_ALLOWED_ORIGINS=https://pmo.example.com
# Public request host allowlist. The loopback image probe sends its first entry as Host.
TRUSTED_HOSTS=api.example.com
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
DEBUG=false
API_DOCS_ENABLED=false
LOG_LEVEL=INFO

DOCUMENT_STORAGE_BACKEND=s3
DOCUMENT_STORAGE_PATH=/app/data/documents
DOCUMENT_MAX_UPLOAD_MB=10
S3_BUCKET=private-document-bucket
S3_REGION=eu-west-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REQUEST_TIMEOUT_SECONDS=20

INTEGRATION_TOKEN_ENCRYPTION_KEY=generate-with-the-documented-fernet-command
INTEGRATION_TIMEOUT_SECONDS=15
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/api/v1/integrations/oauth/google/callback
GOOGLE_OAUTH_SCOPES=openid email https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/gmail.readonly
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://api.example.com/api/v1/integrations/oauth/github/callback
GITHUB_OAUTH_SCOPES=read:user

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.2
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=20
EMBEDDING_VERSION=v1
KNOWLEDGE_CANDIDATE_LIMIT=500

# Public build configuration only: empty/unset means same-origin (gateway routes /api).
# For same-site split hosting, use an HTTPS origin and configure COOKIE_DOMAIN above.
VITE_API_BASE_URL=https://api.example.com
BACKEND_PORT=8000
FRONTEND_PORT=8080
