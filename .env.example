# Copy to .env before starting Docker Compose. Replace this value with a random secret.
SECRET_KEY=replace-with-at-least-32-random-characters
APP_ENV=development

POSTGRES_DB=loris_pmo
POSTGRES_USER=loris
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql+asyncpg://loris:replace-with-a-local-database-password@db:5432/loris_pmo

FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0.2
LOG_LEVEL=INFO

