# Copy to .env before starting Docker Compose. Replace this value with a random secret.
SECRET_KEY=replace-with-at-least-32-random-characters
APP_ENV=development

POSTGRES_DB=loris_pmo
POSTGRES_USER=loris
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql+asyncpg://loris:replace-with-a-local-database-password@db:5432/loris_pmo

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,backend,testserver,test
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
DEBUG=false
API_DOCS_ENABLED=false
DATABASE_SSL_MODE=disable
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.2
LOG_LEVEL=INFO
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=20
EMBEDDING_VERSION=v1
KNOWLEDGE_CANDIDATE_LIMIT=500

# Optional V2.4 OAuth integrations. Leave credentials empty to keep providers unavailable.
# Generate the encryption key with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
INTEGRATION_TOKEN_ENCRYPTION_KEY=
INTEGRATION_TIMEOUT_SECONDS=15
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/google/callback
GOOGLE_OAUTH_SCOPES=openid email https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/gmail.readonly
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/github/callback
GITHUB_OAUTH_SCOPES=read:user


DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=/app/data/documents
DOCUMENT_MAX_UPLOAD_MB=10
# S3-compatible object storage is optional and never required for local mode.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REQUEST_TIMEOUT_SECONDS=20
